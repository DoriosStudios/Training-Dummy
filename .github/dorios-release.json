      "Training Dummy BP",
      "Training Dummy RP"
    ]
  },
  "distribution": {
    "github": true,
    "curseforge": {
      "enabled": true,
      "projectId": 1095457,
      "gameVersion": "26.30"
    }
  },
  "links": {
    "website": "https://doriosstudios.com/projects/dummy/",
    "curseforge": "https://www.curseforge.com/minecraft-bedrock/addons/training-dummy",
    "mcpedl": "https://mcpedl.com/training-dummy/"
  },
  "announcement": {
    "enabled": true,
    "color": "B0D070",
    "imageUrl": "https://doriosstudios.com/img/addons/dummy/MCPEDL.png",
    "automaticDelayMinutes": 60
  }
}
